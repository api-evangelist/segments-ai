{
  "opencollection": "1.0.0",
  "info": {
    "name": "Segments.ai Datasets Releases API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Releases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List the releases of a dataset.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.segments.ai/datasets/:owner/:dataset/releases",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List the releases of a dataset."
        },
        {
          "info": {
            "name": "Create a release (immutable snapshot) of a dataset.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.segments.ai/datasets/:owner/:dataset/releases",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a release (immutable snapshot) of a dataset."
        },
        {
          "info": {
            "name": "Retrieve a single release.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.segments.ai/datasets/:owner/:dataset/releases/:release_name",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path"
              },
              {
                "name": "release_name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single release."
        },
        {
          "info": {
            "name": "Delete a release.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.segments.ai/datasets/:owner/:dataset/releases/:release_name",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path"
              },
              {
                "name": "release_name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a release."
        }
      ]
    }
  ],
  "bundled": true
}